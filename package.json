{
  "name": "audible-backup",
  "version": "1.2.0",
  "description": "Sync an Audible library, download AAX files, and convert them to chapter-split MP3s",
  "main": "app.ts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "sync": "node app.ts sync",
    "convert": "node app.ts convert",
    "sync-convert": "node app.ts sync-convert",
    "status": "node app.ts status",
    "list": "node app.ts list",
    "help": "node app.ts help",
    "db-status": "node app.ts db-status",
    "db-reset": "node app.ts db-reset",
    "test": "node --test test/*.test.ts",
    "test:ui": "node --test test/ui/*.test.ts",
    "test:all": "npm test && npm run test:ui",
    "server": "node server.ts",
    "build:client": "node scripts/build-client.mjs",
    "build:client:watch": "node scripts/build-client.mjs --watch"
  },
  "keywords": [],
  "author": "",
  "type": "module",
  "license": "ISC",
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@tanstack/react-table": "^9.2.4",
    "@tanstack/react-virtual": "^3.14.10",
    "@types/node": "^24.3.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "esbuild": "^0.28.2",
    "playwright-core": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.9",
    "hono": "^4.11.9"
  }
}
