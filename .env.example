AUDIBLE_ACTIVATION_BYTES=
AUDIBLE_TARGET_DIR=~/Music/audible-backup
AUDIBLE_OUTPUT_DIR=~/Music/audible-backup/converted
MP3_QUALITY=4
DOWNLOAD_DELAY_MS=2000
CONVERT_DELAY_MS=1000
LIBRARY_MAX_BUFFER=10485760
DB_PATH=~/Music/audible-backup/audiobooks.db
# Root directory for multi-tenant user data (each user gets a subdirectory)
USERS_DIR=~/Music/audible-backup/users
# Web UI basic auth gate (both must be set to enable). Per-user passwords
# are managed in the web UI itself; this is an extra outer layer.
WEB_USER=
WEB_PASSWORD=
